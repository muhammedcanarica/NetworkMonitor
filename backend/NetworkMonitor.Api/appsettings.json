{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=networkmonitor.db"
  },
  "Monitoring": {
    "IntervalSeconds": 5,
    "PingTimeoutMilliseconds": 2000,
    "FailureThreshold": 3,
    "RecoveryThreshold": 2,
    "MaxConcurrentPings": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
