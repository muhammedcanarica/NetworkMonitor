{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=networkmonitor.db"
  },
  "Monitoring": {
    "IntervalSeconds": 5,
    "PingTimeoutMilliseconds": 2000,
    "FailureThreshold": 3,
    "RecoveryThreshold": 2,
    "MaxConcurrentPings": 10,
    "HistoryRetentionDays": 7
  },
  "IpScanner": {
    "PingTimeoutMilliseconds": 1000,
    "MaxConcurrentPings": 64,
    "MaxAddressesPerScan": 1024,
    "HostNameTimeoutMilliseconds": 500
  },
  "PortScanner": {
    "MaxPortsPerScan": 256,
    "MaxConcurrentConnections": 32,
    "MinimumTimeoutMilliseconds": 100,
    "MaximumTimeoutMilliseconds": 10000
  },
  "ConfigBackup": {
    "ConnectionTimeoutMilliseconds": 10000,
    "CommandTimeoutMilliseconds": 30000,
    "MaxStoredConfigurationLength": 1048576,
    "MaxDiffLines": 2000
  },
  "TopologyDiscovery": {
    "MaxDevicesPerDiscovery": 32,
    "MaxConcurrentDiscoveries": 4
  },
  "SnmpBandwidthMonitoring": {
    "IntervalSeconds": 60,
    "MaxConcurrentDevices": 4,
    "HistoryRetentionDays": 7,
    "RequestTimeoutMilliseconds": 5000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
